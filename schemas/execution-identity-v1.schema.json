{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloudstudio/execution-identity-v1.schema.json",
  "title": "Indoor reconstruction execution identity V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "actorId", "runId", "role", "provider", "model",
    "policyId", "toolPolicyHash", "startedAt", "attestation"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "actorId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "runId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "role": {"enum": ["author", "reviewer", "deterministic-checker", "publisher"]},
    "reviewerClass": {"enum": ["standard", "regional", "adversarial", "deterministic"]},
    "provider": {"type": "string", "minLength": 1, "maxLength": 64},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "policyId": {"type": "string", "minLength": 1},
    "toolPolicyHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "enforcementMode"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "enforcementMode": {"enum": ["application-enforced", "sandbox-enforced", "deterministic-local"]},
        "receiptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "deterministicBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codeSha256", "configDigest", "inputDigests"],
      "properties": {
        "codeSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputDigests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"enum": ["reviewer", "deterministic-checker"]}}},
      "then": {"required": ["reviewerClass"]}
    },
    {
      "if": {"properties": {"role": {"const": "deterministic-checker"}}},
      "then": {
        "required": ["deterministicBinding"],
        "properties": {
          "provider": {"const": "deterministic-checker"},
          "policyId": {"const": "deterministic-checker-v1"},
          "reviewerClass": {"const": "deterministic"}
        }
      }
    }
  ]
}
