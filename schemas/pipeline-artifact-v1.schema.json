{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloudstudio/pipeline-artifact-v1.schema.json",
  "title": "Typed indoor reconstruction pipeline artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "jobId", "captureFingerprint", "payloadDigest", "producer", "inputs", "createdAt", "payload"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "artifactType": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "jobId": {"type": "string", "minLength": 1},
    "captureFingerprint": {"$ref": "#/$defs/sha256"},
    "payloadDigest": {"$ref": "#/$defs/sha256"},
    "producer": {"$ref": "#/$defs/producer"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "createdAt": {"type": "string", "format": "date-time"},
    "payload": {}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "gitSha", "command", "configDigest", "environmentDigest", "randomSeed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "configDigest": {"$ref": "#/$defs/sha256"},
        "environmentDigest": {"$ref": "#/$defs/sha256"},
        "randomSeed": {"type": "integer"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "artifactSha256"],
      "properties": {
        "artifactType": {"type": "string", "minLength": 1},
        "artifactSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
